# ── Data backend ────────────────────────────────────────────────
# The app ships with a fully working localStorage backend (no setup
# required). To use real Supabase instead, set the flag below to
# "supabase" and fill in your project credentials.
#
#   local     -> localStorage (default, zero-config, demo-ready)
#   supabase  -> Supabase (Postgres + Auth)
VITE_DATA_BACKEND=local

# ── Supabase (only needed when VITE_DATA_BACKEND=supabase) ───────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
